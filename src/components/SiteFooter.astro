---
import { site } from '../data/site';
import Asterisk from './Asterisk.astro';

const lastName = site.name.split(' ').at(-1);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="bar">
    <span>© {year} {site.name}</span>
    <span class="credit">Designed and built by me</span>
    <button type="button" class="text-button contact" commandfor="contact" command="show-modal" data-sheet-from="bottom">
      Contact page <span aria-hidden="true">↗</span>
    </button>
  </div>

  <div class="signature" aria-hidden="true">
    <span>{lastName}</span>
    <Asterisk class="signature-asterisk" size="0.42em" spin />
  </div>
</footer>

<style>
  .site-footer {
    container-type: inline-size;
    overflow: hidden;
    background: var(--accent);
    color: var(--ink);
  }

  .site-footer :focus-visible {
    outline-color: currentColor;
  }

  .bar {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    margin-inline: var(--gutter);
    padding-block: 18px;
    border-bottom: 1px solid var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .contact {
    justify-self: end;
  }

  /* The word runs the full width and sinks below the bottom edge. */
  .signature {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 0.06em;
    margin-bottom: -0.17em;
    padding-top: 0.1em;
    font-size: calc((100cqw - 2 * var(--gutter)) / 7.5);
    font-stretch: 125%;
    font-weight: 900;
    line-height: 0.8;
    text-transform: uppercase;
  }

  .signature .signature-asterisk {
    stroke: var(--ink);
  }

  @media (max-width: 639px) {
    .bar {
      grid-template-columns: 1fr auto;
    }

    .credit {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
