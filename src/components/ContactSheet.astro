---
import { site } from '../data/site';
import Asterisk from './Asterisk.astro';
import Marquee from './Marquee.astro';

const contacts = [
  { label: 'Email', handle: site.email, href: `mailto:${site.email}` },
  ...site.profiles,
];
---

<dialog id="contact" class="sheet" aria-labelledby="contact-title">
  <div class="bar">
    <h2 id="contact-title" class="title">
      <span class="mark" aria-hidden="true"></span>
      Contact
    </h2>
    <button type="button" class="close" commandfor="contact" command="close">
      Close <span aria-hidden="true">×</span>
    </button>
  </div>

  <Marquee class="greeting" duration={8} repeat={5}>
    <Asterisk class="greeting-asterisk" spin />
    <span>Say hello</span>
  </Marquee>

  <div class="intro">
    <p class="lede">
      Hiring, building something, or just want to talk code? Pick a channel below and say hi.
    </p>
    <dl class="facts">
      <div>
        <dt>Based in</dt>
        <dd>
          {site.city}, {site.country}
        </dd>
      </div>
      <div data-clock-row hidden>
        <dt>Local time</dt>
        <dd data-clock={site.timeZone}></dd>
      </div>
      <div>
        <dt>Speaks</dt>
        <dd>{site.languages.join(', ')}</dd>
      </div>
    </dl>
  </div>

  <ul class="links">
    {contacts.map(({ label, handle, href }) => (
      <li class="item">
        <a class="link" href={href} target={href.startsWith('https:') ? '_blank' : undefined}>
          <span class="label">{label}</span> <span class="handle">{handle}</span>
          <svg class="arrow" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 18 18 6M8 6h10v10" />
          </svg>
        </a>
        {href.startsWith('mailto:') && (
          <button type="button" class="text-button copy" data-copy={handle} hidden>
            Copy
          </button>
        )}
      </li>
    ))}
  </ul>

  <p class="visually-hidden" role="status" data-copy-status></p>
</dialog>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');

  function show(label: string, announcement: string) {
    if (!button || !status) return;
    button.textContent = label;
    status.textContent = announcement;
    setTimeout(() => {
      button.textContent = 'Copy';
      status.textContent = '';
    }, 2000);
  }

  if (button && navigator.clipboard) {
    button.hidden = false;
    button.addEventListener('click', () => {
      navigator.clipboard.writeText(button.dataset.copy ?? '').then(
        () => show('Copied', 'Email address copied'),
        () => show('Copy failed', 'Could not copy the email address'),
      );
    });
  }

  // My local time, shown only once the script runs, then updated on each new minute.
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  const clockRow = document.querySelector<HTMLElement>('[data-clock-row]');

  if (clock && clockRow) {
    const time = new Intl.DateTimeFormat('en-GB', {
      timeZone: clock.dataset.clock,
      hour: '2-digit',
      minute: '2-digit',
    });

    const tick = () => {
      clock.textContent = time.format(new Date());
      setTimeout(tick, 60_000 - (Date.now() % 60_000));
    };

    tick();
    clockRow.hidden = false;
  }
</script>

<style>
  .sheet {
    --sheet-size: clamp(56px, min(12.2vw, 12.5dvh), 176px);
    --ease: cubic-bezier(0.2, 0.8, 0.2, 1);
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--accent);
    color: var(--ink);
    translate: 0 -100%;
    transition:
      translate 0.5s var(--ease),
      display 0.5s allow-discrete,
      overlay 0.5s allow-discrete;
  }

  .sheet[open] {
    display: flex;
    flex-direction: column;
    translate: 0 0;
  }

  @starting-style {
    .sheet[open] {
      translate: 0 -100%;
    }
  }

  .sheet::backdrop {
    background: none;
  }

  .sheet :focus-visible {
    outline-color: currentColor;
  }

  .bar,
  .facts,
  .copy {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px var(--gutter);
  }

  .title {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: inherit;
    font-weight: 700;
  }

  .mark {
    width: 12px;
    height: 12px;
    background: var(--ink);
  }

  .close {
    padding: 5px 9px;
    border: 2px solid var(--ink);
    background: none;
    color: inherit;
    font: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
  }

  .close:hover {
    background: var(--ink);
    color: var(--accent);
  }

  .greeting {
    --marquee-gap: 0.3em;
    flex: none;
    padding-top: 0.08em;
    font-size: calc(var(--sheet-size) * 0.9);
    font-stretch: 62%;
    font-weight: 900;
    line-height: 0.8;
    text-transform: uppercase;
  }

  .greeting .greeting-asterisk {
    stroke: var(--ink);
  }

  .intro {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px 48px;
    margin-top: auto;
    padding: 32px var(--gutter);
  }

  .lede {
    max-width: 20em;
    font-size: clamp(20px, 1.9vw, 34px);
    font-weight: 500;
    line-height: 1.2;
  }

  .facts {
    display: grid;
    grid-template-columns: auto auto;
    gap: 6px 32px;
    font-size: var(--text-meta);
  }

  .facts div:not([hidden]) {
    display: grid;
    grid-column: span 2;
    grid-template-columns: subgrid;
  }

  /* 80% ink still clears 4.5:1 contrast on the orange. */
  .facts dt {
    color: color-mix(in srgb, var(--ink) 80%, transparent);
  }

  .facts dd {
    margin: 0;
  }

  /* Every row shares the copy column, so the arrows line up even where there is nothing to copy. */
  .links {
    display: grid;
    grid-template-columns: 1fr auto;
    margin-bottom: var(--gutter);
    padding: 0;
    border-bottom: 2px solid var(--ink);
    list-style: none;
  }

  .item {
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: center;
    border-top: 2px solid var(--ink);
  }

  .item:hover,
  .item:focus-within {
    background: var(--ink);
    color: var(--ground);
  }

  .link {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 24px;
    padding: 0.1em var(--gutter) 0.06em;
    font-size: var(--sheet-size);
    line-height: 0.8;
    text-decoration: none;
  }

  .link:focus-visible {
    outline-offset: -6px;
  }

  .label {
    margin-right: auto;
    font-stretch: 62%;
    font-weight: 900;
    text-transform: uppercase;
    transition: font-stretch 0.4s var(--ease);
  }

  /* Touch screens keep hover after a tap, and the wider label would not fit on a phone. */
  @media (hover: hover) {
    .link:hover .label,
    .link:focus-visible .label {
      font-stretch: 100%;
    }
  }

  .handle {
    font-family: var(--font-mono);
    font-size: 14px;
    line-height: 1.2;
  }

  .arrow {
    flex: none;
    width: 0.3em;
    height: 0.3em;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .item:hover .arrow,
  .item:focus-within .arrow {
    stroke: var(--accent);
  }

  /* Full row height for an easy target, and wide enough for "Copied" so the arrows stay put. */
  .copy {
    align-self: stretch;
    min-width: calc(7ch + var(--gutter));
    padding-right: var(--gutter);
    text-align: right;
  }

  /* On phones the handle drops under the label and the copy button joins it on that line. */
  @media (max-width: 639px) {
    .links {
      grid-template-columns: 1fr;
    }

    /* Leaves room for TELEGRAM and its arrow on one line at 320px. */
    .link {
      column-gap: 12px;
    }

    .handle {
      order: 1;
      flex-basis: 100%;
      font-size: min(14px, 4vw);
    }

    .link,
    .copy {
      grid-area: 1 / 1;
    }

    .copy {
      align-self: end;
      justify-self: end;
      padding-bottom: 4px;
    }
  }
</style>
