---
import { history } from '../data/history';

const command = '$ git log main';
const branchIndex = history.findIndex((commit) => commit.branch);
---

<section class="history" id="work" aria-labelledby="history-title">
  <div class="head" data-reveal="waiting" style={`--chars: ${command.length}`}>
    <p class="label">
      (02) Work / <span class="command">{command}</span>
    </p>
    <h2 id="history-title" class="title">
      <span class="word">
        <span>Version</span>
      </span>{' '}
      <span class="word" style="--i: 1">
        <span>history</span>
      </span>
    </h2>
    <p class="lede">My career as releases. Each job is a version, each project a commit.</p>
  </div>

  <ol class="log" data-reveal="waiting" style={`--rows: ${history.length}`}>
    {history.map(({ hash, type, scope, message, date, tag, branch }, index) => (
      <li class="commit" style={`--i: ${index}`}>
        <div
          class:list={['graph', { first: index === 0, last: index === history.length - 1 }]}
          aria-hidden="true"
        >
          <span class="line trunk" />
          {index <= branchIndex && (
            <span class:list={['line', 'side', { end: index === branchIndex }]} />
          )}
          {branch && (
            <svg class="fork" viewBox="0 0 10 10" preserveAspectRatio="none">
              <path d="M10 0C10 6 0 4 0 10" />
            </svg>
          )}
          <span
            class:list={[
              'node',
              { head: index === 0, release: type === 'release', 'on-branch': branch },
            ]}
          />
        </div>
        <div class="body">
          <code class="hash">{hash}</code>
          <p class="message">
            {index === 0 && <span class="ref head">HEAD</span>}
            {tag && <span class="ref">{tag}</span>}
            {branch && <span class="ref branch">{branch}</span>}
            <code class="type">{scope ? `${type}(${scope})` : type}:</code> {message}
          </p>
          <time class="date">{date}</time>
        </div>
      </li>
    ))}
  </ol>
</section>

<script>
  import '../scripts/reveal';
</script>

<style>
  .history {
    padding: 64px var(--gutter) 96px;
  }

  .label,
  .hash,
  .type,
  .ref,
  .date {
    font-family: var(--font-mono);
  }

  .label {
    color: var(--muted);
    font-size: var(--text-label);
    letter-spacing: 0.1em;
    line-height: 1.55;
    text-transform: uppercase;
  }

  .title {
    margin-top: 16px;
    font-size: clamp(56px, 11vw, 176px);
    font-stretch: 62%;
    font-weight: 900;
    line-height: 0.8;
    word-spacing: 0.08em;
    text-transform: uppercase;
  }

  .word {
    display: inline-block;
  }

  .word > span {
    display: inline-block;
  }

  .lede {
    max-width: 20.5em;
    margin-top: 36px;
    font-size: var(--text-lede);
    font-weight: 500;
    line-height: 1.55;
  }

  .log {
    --graph: 136px;
    --lane-trunk: 36px;
    --lane-branch: 92px;
    margin-top: 44px;
    padding: 0;
    list-style: none;
  }

  .log::before,
  .log::after {
    content: '';
    display: block;
    height: 2px;
    background: var(--ink);
  }

  .commit {
    display: grid;
    grid-template-columns: var(--graph) 1fr;
  }

  .graph {
    position: relative;
  }

  .line {
    position: absolute;
    inset-block: 0;
    left: calc(var(--lane-trunk) - 1px);
    width: 2px;
    background: var(--ink);
  }

  .first .trunk {
    top: 50%;
  }

  .last .trunk {
    bottom: 50%;
  }

  .side {
    left: calc(var(--lane-branch) - 1px);
    background: repeating-linear-gradient(var(--ink) 0 5px, transparent 5px 10px);
  }

  .side.end {
    bottom: 50%;
  }

  /* Stretched to fill the gap between the lanes; the stroke keeps its width. */
  .fork {
    position: absolute;
    top: 50%;
    left: var(--lane-trunk);
    width: calc(var(--lane-branch) - var(--lane-trunk));
    height: 50%;
    overflow: visible;
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
  }

  .fork path {
    vector-effect: non-scaling-stroke;
  }

  .node {
    position: absolute;
    top: 50%;
    left: var(--lane-trunk);
    width: 18px;
    height: 18px;
    border: 2px solid var(--ink);
    border-radius: 50%;
    background: var(--ground);
    translate: -50% -50%;
  }

  .node.release {
    background: var(--ink);
  }

  .node.head {
    width: 24px;
    height: 24px;
    border-color: var(--accent);
    background: var(--accent);
  }

  .node.on-branch {
    left: var(--lane-branch);
  }

  .body {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'hash date'
      'message message';
    align-items: baseline;
    gap: 6px 16px;
    padding: 16px 0 18px;
    border-bottom: 1px solid var(--rule);
  }

  .commit:last-child .body {
    border-bottom: 0;
  }

  .hash,
  .date {
    color: var(--muted);
    font-size: var(--text-meta);
    letter-spacing: 0.04em;
  }

  .hash {
    grid-area: hash;
  }

  .date {
    grid-area: date;
  }

  .message {
    grid-area: message;
    font-size: var(--text-body);
    font-weight: 500;
    line-height: 1.3;
  }

  .type {
    font-size: 13px;
    font-weight: 700;
  }

  .ref {
    display: inline-block;
    margin-right: 8px;
    padding: 2px 6px;
    border: 1px solid var(--ink);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    line-height: 1.4;
    text-transform: uppercase;
    vertical-align: 2px;
  }

  .ref.head {
    border-color: var(--accent);
    background: var(--accent);
  }

  .ref.branch {
    border-style: dashed;
  }

  @media (min-width: 760px) {
    .body {
      grid-template-columns: 96px 1fr auto;
      grid-template-areas: 'hash message date';
      padding: 23px 16px;
    }
  }

  @media (max-width: 759px) {
    .log {
      --graph: 56px;
      --lane-trunk: 16px;
      --lane-branch: 44px;
    }
  }

  /*
   * Appearance: `git log` prints itself. The command types out, the title rises,
   * then the graph draws down one commit at a time and each row sweeps out from its node.
   * Blocks wait hidden until the script marks them shown. Without scripts, with reduced
   * motion, or with motion paused from the header, everything is simply visible.
   */
  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .history {
      --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
      --step: 110ms;
    }

    .head {
      --typing: calc(var(--chars) * 28ms);
    }

    /*
     * Typed one character per step: a monospace character is 1ch plus the letter spacing.
     * The right border is the caret, and it disappears once the command is typed.
     */
    .command {
      display: inline-block;
      width: calc(1ch + var(--chars) * (1ch + 0.1em));
      overflow: hidden;
      border-right: 1ch solid transparent;
      vertical-align: top;
      white-space: nowrap;
      transition:
        width var(--typing) steps(var(--chars)),
        border-right-color 0s calc(var(--typing) + 250ms);
    }

    .word {
      clip-path: inset(-0.2em -0.1em 0);
    }

    .word > span {
      transition: translate 900ms var(--ease-out) calc(var(--typing) + var(--i, 0) * 90ms);
    }

    .lede {
      transition:
        opacity 700ms ease calc(var(--typing) + 300ms),
        translate 900ms var(--ease-out) calc(var(--typing) + 300ms);
    }

    .log::before,
    .log::after {
      transform-origin: left;
      transition: scale 800ms var(--ease-out);
    }

    .log::after {
      transition-delay: calc(var(--rows) * var(--step));
    }

    .graph {
      clip-path: inset(0);
      transition: clip-path var(--step) linear calc(var(--i) * var(--step));
    }

    .node {
      transition: scale 400ms cubic-bezier(0.34, 1.8, 0.64, 1) calc((var(--i) + 0.5) * var(--step));
    }

    .body {
      clip-path: inset(0);
      transition: clip-path 700ms var(--ease-out) calc((var(--i) + 0.5) * var(--step));
    }

    :global(:root:not([data-motion='off'])) [data-reveal='waiting'] {
      .command {
        width: 1ch;
        border-right-color: var(--ink);
      }

      .word > span {
        translate: 0 105%;
      }

      .lede {
        opacity: 0;
        translate: 0 16px;
      }

      &.log::before,
      &.log::after {
        scale: 0 1;
      }

      .graph {
        clip-path: inset(0 0 100% 0);
      }

      .node {
        scale: 0;
      }

      .body {
        clip-path: inset(0 100% 0 0);
      }
    }
  }
</style>
