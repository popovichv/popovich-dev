---
import { site } from '../data/site';
import Logo from '../assets/logo-light.svg';
import MotionToggle from './MotionToggle.astro';

interface Props {
  fullscreen?: boolean;
}

const { fullscreen = false } = Astro.props;
---

<header class:list={['site-header', { fullscreen }]}>
  <div class="screen">
    <div class="bar">
      <span class="brand">
        <Logo width={22} height={22} aria-hidden="true" />
        {site.name} / {site.role.toLowerCase()}
      </span>
      <span>
        {site.city}, {site.country}
      </span>
      <div class="actions">
        <MotionToggle />
        <button type="button" class="text-button" commandfor="contact" command="show-modal">
          Contact
        </button>
      </div>
    </div>
    <slot />
  </div>
</header>

<style>
  /* The bar and the slotted hero share the first screen. */
  .fullscreen .screen {
    position: sticky;
    top: 0;
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100svh;
  }

  /*
   * The first screen stays pinned for this much scrolling while the hero plays its exit,
   * then scrolls away. Without the exit (no scripts or reduced motion) there is nothing to wait for.
   */
  .fullscreen {
    --runway: 100svh;
  }

  @media (scripting: enabled) and (prefers-reduced-motion: no-preference) {
    .fullscreen {
      height: calc(100svh + var(--runway));
    }
  }

  .bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 18px var(--gutter);
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
  }

  .actions {
    display: flex;
    gap: 28px;
  }
</style>
