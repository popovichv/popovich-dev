---
import { site } from '../data/site';
import Asterisk from './Asterisk.astro';
---

<section class="intro" aria-label="Intro">
  <div class="column">
    <h2 class="label">Now</h2>
    <p class="bio">{site.bio}</p>
  </div>

  <div class="column">
    <h2 class="label">Before that</h2>
    <ul class="list">
      {site.previously.map(({ work, org, place }) => (
        <li class="item">
          <Asterisk class="bullet" size="13px" strokeWidth={14} />
          <span>
            {work}{' '}
            <span class="where">
              ({org}, {place})
            </span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .intro {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    gap: 32px;
    padding: 36px var(--gutter) 64px;
    border-bottom: 2px solid var(--ink);
  }

  /* Up to three columns of at least 280px. The third stays empty until the projects link returns. */
  @media (min-width: 648px) {
    .intro {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .intro {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .bio {
    max-width: 440px;
    font-size: 22px;
    font-weight: 500;
    line-height: 1.25;
  }

  .bio::after {
    content: '';
    display: inline-block;
    width: 12px;
    height: 22px;
    margin-left: 4px;
    vertical-align: -3px;
    background: var(--ink);
    animation: cursor-blink 1s step-end infinite;
  }

  :global(:root[data-motion='off']) .bio::after {
    animation: none;
  }

  @keyframes cursor-blink {
    50% {
      opacity: 0;
    }
  }

  .column {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .label {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 400;
    letter-spacing: 0.1em;
    line-height: 1.55;
    text-transform: uppercase;
  }

  .list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 0;
    list-style: none;
    font-size: 18px;
    font-weight: 500;
    line-height: 1.3;
  }

  .item {
    display: flex;
    align-items: baseline;
    gap: 12px;
  }

  .bullet {
    translate: 0 1px;
  }

  .where {
    display: block;
    color: var(--muted);
  }
</style>
