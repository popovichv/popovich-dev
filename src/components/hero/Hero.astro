---
import { site } from '../../data/site';
import Asterisk from '../Asterisk.astro';
import Marquee from '../Marquee.astro';
import PhotoCapsule from './PhotoCapsule.astro';
import Slash from './Slash.astro';

const [firstName, lastName] = site.name.split(' ');
---

<div class="hero">
  <h1 class="visually-hidden">
    {site.name}, {site.role.toLowerCase()}, {site.city}
  </h1>

  <div class="rows" aria-hidden="true" data-hero-rows>
    <Marquee class="name" duration={40} repeat={3}>
      <span>{firstName}</span>
      <PhotoCapsule class="name-photo" />
      <span>{lastName}</span>
      <Asterisk class="name-asterisk" spin />
    </Marquee>

    <Marquee class="outlined" direction="right" duration={80} repeat={2}>
      <span>{lastName}</span>
      <span>{firstName}</span>
    </Marquee>

    <Marquee class="band accent-band" duration={11} repeat={2}>
      <span>{site.name}</span>
      <span class="dot">●</span>
    </Marquee>

    <Marquee class="stack" direction="right" duration={55}>
      {site.stack.map((tech) => (
        <>
          <span>{tech}</span>
          <Slash />
        </>
      ))}
    </Marquee>

    <Marquee class="band ink-band" duration={40}>
      <span>{site.role}</span>
      <Asterisk spin />
      <span>{site.city}</span>
      <Asterisk spin />
    </Marquee>

    {/* An even number of tools keeps solid and outline alternating across the loop seam. */}
    <Marquee class="tools" direction="right" duration={40}>
      {site.tools.map((tool, index) => (
        <span class:list={{ 'accent-outline': index % 2 }}>{tool}</span>
      ))}
    </Marquee>
  </div>
</div>

<style>
  .hero {
    container-type: size;
    overflow-x: clip;
  }

  /*
   * Sized so the rows fill the height under the header bar: six rows at line-height 0.8,
   * 0.08em of padding on each of the two bands, and 6px above the first row.
   * On tall, narrow screens the width caps the size and the spare space sits above the rows.
   */
  .rows {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    height: 100%;
    font-size: min((100cqh - 6px) / 4.96, 30cqw);
    font-weight: 900;
    line-height: 0.8;
    text-transform: uppercase;
  }

  .name {
    --marquee-gap: 0.18em;
    padding-top: 6px;
    font-stretch: 62%;
  }

  .name-asterisk {
    margin-inline: 0.04em;
  }

  .outlined {
    --marquee-gap: 0.3em;
    font-stretch: 125%;
    font-weight: 800;
    color: transparent;
    -webkit-text-stroke: 2px var(--ink);
  }

  .band {
    padding: 0.06em 0 0.02em;
    font-stretch: 100%;
  }

  .accent-band {
    --marquee-gap: 0.3em;
    background: var(--accent);
    color: var(--ink);
  }

  /* The design leaves 0.27em after the dot, slightly less than the row gap. */
  .dot {
    font-size: 0.3em;
    margin-right: -0.1em;
  }

  .stack {
    --marquee-gap: 0.25em;
    font-stretch: 62%;
    font-weight: 200;
  }

  .ink-band {
    --marquee-gap: 0.25em;
    background: var(--ink);
    color: var(--ground);
  }

  .tools {
    --marquee-gap: 0.3em;
    font-stretch: 80%;
    font-style: italic;
    font-weight: 700;
  }

  .accent-outline {
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 2.5px var(--accent);
  }

  /*
   * Rows travel along their own track. On load each one rushes in from the side its text
   * comes from and brakes into place. Scrolling away sends it out the other side, leaning
   * into the speed; the script below sets --exit from 0 to 1.
   */
  .rows > [data-direction='left'] {
    --dir: -1;
  }

  .rows > [data-direction='right'] {
    --dir: 1;
  }

  .rows > :nth-child(2) {
    --row: 1;
  }

  .rows > :nth-child(3) {
    --row: 2;
  }

  .rows > :nth-child(4) {
    --row: 3;
  }

  .rows > :nth-child(5) {
    --row: 4;
  }

  .rows > :nth-child(6) {
    --row: 5;
  }

  @media (prefers-reduced-motion: no-preference) {
    .rows > * {
      animation: row-in 1.5s cubic-bezier(0.16, 1, 0.3, 1) calc(var(--row, 0) * 90ms) backwards;
      transform: translateX(calc(var(--dir) * pow(var(--exit, 0), 2) * 110%))
        skewX(calc(var(--dir) * var(--exit, 0) * -14deg));
      will-change: transform;
    }

    /* Once the name has landed, the photo opens out from the middle of its capsule. */
    .name-photo {
      animation: capsule-open 900ms cubic-bezier(0.65, 0, 0.35, 1) 550ms backwards;
    }
  }

  @keyframes row-in {
    from {
      translate: calc(var(--dir) * -100%) 0;
    }
  }

  @keyframes capsule-open {
    from {
      clip-path: inset(0 50% round 999px);
    }

    to {
      clip-path: inset(0 round 999px);
    }
  }
</style>

<script>
  if (matchMedia('(prefers-reduced-motion: no-preference)').matches) {
    const container = document.querySelector<HTMLElement>('[data-hero-rows]')!;
    const stage = container.closest('header')!;
    const rows = Array.from(container.children as HTMLCollectionOf<HTMLElement>);
    const loops = rows.map((row) =>
      row
        .getAnimations({ subtree: true })
        .filter((animation) => animation.effect?.getTiming().iterations === Infinity),
    );

    // The header holds the first screen in place, then lets it scroll away. Each row is gone by the
    // time its bottom edge reaches the top of the viewport: where that edge sits once released.
    let distances: number[] = [];

    const measure = () => {
      const release = stage.getBoundingClientRect().bottom + window.scrollY;
      const { bottom } = container.getBoundingClientRect();
      distances = rows.map((row) => release - (bottom - row.getBoundingClientRect().bottom));
    };

    const update = () => {
      rows.forEach((row, index) => {
        const exit = Math.min(window.scrollY / distances[index], 1);
        row.style.setProperty('--exit', exit.toFixed(3));
        loops[index].forEach((loop) => loop.updatePlaybackRate(1 + exit * 9));
      });
    };

    measure();
    update();
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', () => {
      measure();
      update();
    });
  }
</script>
