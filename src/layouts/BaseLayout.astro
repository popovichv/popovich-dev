---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/archivo/wdth-italic.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/700.css';
import '../styles/tokens.css';
import '../styles/global.css';

import archivoLatin from '@fontsource-variable/archivo/files/archivo-latin-wdth-normal.woff2?url';
import logoDark from '../assets/logo-dark.svg?url';
import logoLight from '../assets/logo-light.svg?url';
import ContactSheet from '../components/ContactSheet.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.bio } = Astro.props;

const siteTitle = `${site.name}, ${site.role.toLowerCase()}`;
const pageTitle = title ? `${title} · ${site.name}` : siteTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: site.role,
  url: Astro.site?.href,
  email: site.email,
  knowsLanguage: site.languages,
  sameAs: site.profiles.map((profile) => profile.href),
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressCountry: site.country,
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={logoLight} type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href={logoDark} type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f4f4f2" />
    <link rel="preload" href={archivoLatin} as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(person)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader fullscreen={Astro.slots.has('hero')}>
      <slot name="hero" />
    </SiteHeader>
    <main id="main">
      <slot />
    </main>
    <ContactSheet />
  </body>
</html>
